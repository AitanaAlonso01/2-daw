<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>
</head>
<body>
    <h1>Register</h1>
    <form method="POST" action="/api/v1/users/register"> <!-- llamamos por POST a la ruta /register de user.routes -->
        <!-- Nos fijamos en el user.model para extraer exactamente los campos username y password, requeridos, para crear el usuario-->
         <h4>Creación de un nuevo usuario</h4>
        <input type="text" name="username" placeholder="Username..." required>
        <br>
        <input type="password" name="password" placeholder="Password..." required>
        <br>
        <button>Registrar</button>
    </form>
</body>
</html>